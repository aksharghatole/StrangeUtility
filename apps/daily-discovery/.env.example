DATABASE_URL=sqlite:///./data/daily_discovery.db
APP_TIMEZONE=UTC
DAILY_NOTIFICATION_ENABLED=false
NASA_API_KEY=DEMO_KEY
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_MODE=local
# Local development only. Generate your own random key; never commit .env.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
POSTGRES_DB=daily_discovery
POSTGRES_USER=daily_discovery
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
